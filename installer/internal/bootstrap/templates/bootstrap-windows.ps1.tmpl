<#
  ProjectAchilles endpoint bootstrap (Windows PowerShell 5.1+) -- generated, do not edit.
  Server: {{.Host}}

  Run from an elevated PowerShell:
      .\bootstrap-windows.ps1 -Token <enrollment-token>

  1. Locks C:\F0 to SYSTEM + Administrators before anything is downloaded.
  2. Downloads the server root CA over HTTP into memory and aborts unless its
     SHA-256 matches the value pinned below (the pin, not the transport, is the
     trust anchor).
  3. Trusts those same verified bytes in Cert:\LocalMachine\Root (skipped if
     already present, e.g. via GPO).
  4. Downloads the agent over HTTPS into C:\F0, locks it, renames it to
     C:\F0\achilles-agent.exe and enrolls it.

  Nothing is staged in %TEMP% or any other folder the user's unelevated token
  can write to, so that token cannot swap the root or the SYSTEM service binary.
#>
param([Parameter(Mandatory)][string]$Token)

$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'

$PinnedRootSha256 = '{{.RootSHA256}}'

$isAdmin = ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
if (-not $isAdmin) { throw 'This script must run as Administrator (elevated PowerShell).' }

[Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12

# The service runs the binary from where --install is run, so it must be its
# permanent home (the documented path, also the one ASR exclusions name). The
# download lands next to it so the final rename stays in one directory.
$dir = 'C:\F0'
$exe = 'C:\F0\achilles-agent.exe'
$download = 'C:\F0\achilles-agent.download'

# Well-known SIDs, never localized account names.
$systemSid = New-Object System.Security.Principal.SecurityIdentifier 'S-1-5-18'
$adminsSid = New-Object System.Security.Principal.SecurityIdentifier 'S-1-5-32-544'

function Test-ReparsePoint([string]$Path) {
    $item = Get-Item -LiteralPath $Path -Force
    return [bool]($item.Attributes -band [IO.FileAttributes]::ReparsePoint)
}

# --- 1. Lock C:\F0 before any download -----------------------------------
# Under C:\ a new folder inherits Modify for every signed-in user, which lets
# the unelevated token delete or replace files in it. Protected DACL with only
# SYSTEM + Administrators (inherited by everything created inside), owner
# Administrators so the user keeps no implicit owner rights. An existing C:\F0
# gets the same DACL; children that inherit pick it up, contents are kept.
$dirAcl = New-Object System.Security.AccessControl.DirectorySecurity
$dirAcl.SetOwner($adminsSid)
$dirAcl.SetAccessRuleProtection($true, $false)
foreach ($sid in $systemSid, $adminsSid) {
    $dirAcl.AddAccessRule((New-Object System.Security.AccessControl.FileSystemAccessRule($sid, 'FullControl', 'ContainerInherit, ObjectInherit', 'None', 'Allow')))
}
if (Test-Path -LiteralPath $dir) {
    if (-not (Test-Path -LiteralPath $dir -PathType Container)) { throw "$dir exists and is not a directory; aborting." }
} else {
    # Created with the locked DACL in one step, so there is no window with the inherited one.
    [void][System.IO.Directory]::CreateDirectory($dir, $dirAcl)
}
if (Test-ReparsePoint $dir) { throw "$dir is a junction or symbolic link; aborting." }
Set-Acl -LiteralPath $dir -AclObject $dirAcl

# Verify after locking: once this holds, the unelevated token can no longer
# rename, replace or re-permission the directory.
$dirNow = Get-Acl -LiteralPath $dir
$dirOwner = $dirNow.GetOwner([System.Security.Principal.SecurityIdentifier]).Value
$foreign = @($dirNow.GetAccessRules($true, $true, [System.Security.Principal.SecurityIdentifier]) | Where-Object { $_.IdentityReference.Value -ne 'S-1-5-18' -and $_.IdentityReference.Value -ne 'S-1-5-32-544' })
if ((Test-ReparsePoint $dir) -or $dirOwner -ne 'S-1-5-32-544' -or -not $dirNow.AreAccessRulesProtected -or $foreign.Count -ne 0) {
    throw "Could not lock $dir to SYSTEM + Administrators; aborting."
}
Write-Host "Locked $dir to SYSTEM + Administrators."

# --- 2. Root CA: download into memory, verify, import the same bytes -----
Write-Host "Downloading root CA from http://{{.Host}}/ca/root.cer"
$rootBytes = (Invoke-WebRequest -UseBasicParsing -Uri "http://{{.Host}}/ca/root.cer").RawContentStream.ToArray()

$sha256 = [System.Security.Cryptography.SHA256]::Create()
$actual = -join ($sha256.ComputeHash($rootBytes) | ForEach-Object { $_.ToString('x2') })
if ($actual -ne $PinnedRootSha256.ToLowerInvariant()) {
    throw "Root CA fingerprint mismatch: expected $PinnedRootSha256, got $actual. Aborting; nothing was trusted."
}
Write-Host "Root CA SHA-256 verified: $actual"

# Parsed from the hashed byte array itself: no file is written or re-read.
$root = New-Object System.Security.Cryptography.X509Certificates.X509Certificate2 -ArgumentList (,$rootBytes)
$thumb = $root.Thumbprint
if (Test-Path "Cert:\LocalMachine\Root\$thumb") {
    Write-Host 'Root CA already trusted (e.g. via GPO); skipping import.'
} else {
    $store = New-Object System.Security.Cryptography.X509Certificates.X509Store([System.Security.Cryptography.X509Certificates.StoreName]::Root, [System.Security.Cryptography.X509Certificates.StoreLocation]::LocalMachine)
    $store.Open([System.Security.Cryptography.X509Certificates.OpenFlags]::ReadWrite)
    try { $store.Add($root) } finally { $store.Close() }
    if (-not (Test-Path "Cert:\LocalMachine\Root\$thumb")) { throw 'Root CA import into Cert:\LocalMachine\Root failed.' }
    Write-Host 'Root CA added to Cert:\LocalMachine\Root.'
}

# --- 3. Agent: download into the locked C:\F0, lock, rename --------------
foreach ($p in $download, $exe) {
    if (Test-Path -LiteralPath $p -PathType Container) { throw "$p is a directory; aborting." }
}
if (Test-Path -LiteralPath $download) { Remove-Item -LiteralPath $download -Force }

Write-Host "Downloading agent from https://{{.Host}}"
Invoke-WebRequest -UseBasicParsing -Uri "https://{{.Host}}/api/agent/download?os=windows&arch=amd64" -OutFile $download

# The file already inherits the directory's DACL; make owner and DACL explicit
# and protected anyway, so they do not depend on inheritance or on the
# default-owner policy.
$acl = New-Object System.Security.AccessControl.FileSecurity
$acl.SetOwner($adminsSid)
$acl.SetAccessRuleProtection($true, $false)
foreach ($sid in $systemSid, $adminsSid) {
    $acl.AddAccessRule((New-Object System.Security.AccessControl.FileSystemAccessRule($sid, 'FullControl', 'Allow')))
}
Set-Acl -LiteralPath $download -AclObject $acl

# A running agent holds its binary open; --install re-creates the service anyway.
# The SCM reports Stopped a few milliseconds before the service process has
# exited and released its image; replacing the file in that window fails
# ("Cannot create a file when that file already exists"). So wait for the
# service's own process (by PID: an exiting process no longer reports a Path).
$svc = Get-CimInstance -ClassName Win32_Service -Filter "Name='AchillesAgent'" -ErrorAction SilentlyContinue
if ($svc) {
    $svcPid = [int]$svc.ProcessId
    Stop-Service -Name AchillesAgent -Force -ErrorAction SilentlyContinue
    if ($svcPid -gt 0) { Wait-Process -Id $svcPid -Timeout 60 -ErrorAction SilentlyContinue }
}
if (@(Get-Process -Name achilles-agent -ErrorAction SilentlyContinue | Where-Object { $_.Path -eq $exe }).Count -gt 0) {
    throw "$exe is still running after stopping AchillesAgent; aborting."
}
# Same-directory rename: the file keeps the ACL set above.
Move-Item -Force -LiteralPath $download -Destination $exe
Write-Host "Agent installed at $exe"

& $exe --enroll $Token --server https://{{.Host}} --install
$code = $LASTEXITCODE
if ($code -ne 0) { Write-Host "Agent enrollment failed (exit code $code)." }
exit $code
