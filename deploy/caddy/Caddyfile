# ProjectAchilles — Caddy reverse proxy (single public origin)
#
# This file is intentionally static. What changes between deployments lives
# in three snippets that scripts/deploy-server.sh renders from your TLS_MODE
# into deploy/caddy/rendered/ (gitignored, mounted at /etc/caddy/rendered):
#
#   tls.caddy          TLS strategy for the site      (from tls-modes/<mode>.caddy)
#   global.caddy       extra global options            (from global.caddy, or
#                                                       extras/<mode>.global.caddy)
#   sites-extra.caddy  extra top-level site blocks     (from sites-extra.caddy, or
#                                                       extras/<mode>.sites.caddy)
#
# The imports below use glob patterns (tls*.caddy etc.) on purpose: a glob that
# matches nothing is a warning, while a missing literal path stops Caddy. So a
# checkout pulled without re-running deploy-server.sh still starts (with Caddy's
# default automatic HTTPS) instead of crash-looping on an empty rendered/.
#
# Topology: Caddy terminates TLS on :443 and reverse-proxies everything to
# the frontend container. The frontend (nginx) serves the SPA and proxies
# /api -> backend:3000 internally, so the whole app lives on one origin.
#
# ACHILLES_DOMAIN is injected as an environment variable (see
# docker-compose.server.yml). Example: achilles.example.com

{
	# Global options
	# No global `email`: the ACME modes pass {$ACME_EMAIL} in their tls snippet,
	# and an empty `email` line would stop Caddy starting in the modes that
	# don't collect one (internal, byo, achilles-ca).
	# Admin API disabled. Config changes (and a renewed achilles-ca
	# intermediate) therefore need a container restart, not `caddy reload`.
	admin off

	# Per-mode global options (e.g. the achilles-ca `pki` block).
	import /etc/caddy/rendered/global*.caddy
}

{$ACHILLES_DOMAIN} {
	encode zstd gzip

	# Larger uploads (agent binaries, cert bundles) — match the nginx limit.
	request_body {
		max_size 50MB
	}

	# TLS strategy is rendered per-deployment into rendered/tls.caddy.
	import /etc/caddy/rendered/tls*.caddy

	reverse_proxy frontend:80 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output stdout
		format console
	}
}

# Per-mode extra sites (e.g. the achilles-ca plain-HTTP /ca/* site).
import /etc/caddy/rendered/sites-extra*.caddy
