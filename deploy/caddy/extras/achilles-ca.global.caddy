# TLS_MODE=achilles-ca — global options, imported INSIDE the Caddyfile's
# global block as rendered/global.caddy.
#
# Caddy's default "local" CA (used by `tls internal`) signs leaves with the
# installer's ProjectAchilles intermediate. The CA files come from
# /etc/projectachilles/ca/caddy on the host, mounted read-only as a directory.
#
# The root KEY is deliberately absent: Caddy only needs the root certificate
# (to build the chain), and it never renews an intermediate that is supplied
# here. The host renews it (`achilles-installer ca renew`, weekly systemd
# timer) and restarts the Caddy container, which re-reads these files; the
# restart first deletes cached leaves, which Caddy would otherwise keep serving.
skip_install_trust
pki {
	ca local {
		name "ProjectAchilles"
		root {
			cert /etc/caddy/ca/root.crt
		}
		intermediate {
			cert /etc/caddy/ca/intermediate.crt
			key /etc/caddy/ca/intermediate.key
		}
	}
}
