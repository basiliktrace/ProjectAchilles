# Reference copy of the default TLS strategy — NOT mounted into Caddy.
# The active snippet is deploy/caddy/rendered/tls.caddy (gitignored), which
# scripts/deploy-server.sh renders from tls-modes/<TLS_MODE>.caddy and the
# Caddyfile imports as /etc/caddy/rendered/tls.caddy. The default is Caddy's
# internal CA, so the stack runs without a public domain.
tls internal
